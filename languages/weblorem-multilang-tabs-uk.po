#. Plugin Name of the plugin
#: weblorem-multilang-tabs.php:3 src/Admin/SettingsPage.php:21
#: src/Admin/SettingsPage.php:22
msgid "WebLorem Multilang Tabs"
msgstr "WebLorem Multilang Tabs"

#. Description of the plugin
#: weblorem-multilang-tabs.php:4
msgid ""
"Multilingual content stored inside a single post/term, with "
"one language tab bar in the editor."
msgstr ""
"Багатомовний контент в одному записі/терміні з єдиною "
"панеллю вкладок мов у редакторі."

#. Author of the plugin
#: weblorem-multilang-tabs.php:8
msgid "WebLorem"
msgstr "WebLorem"

#: src/Admin/ImportExport.php:65
msgid "Choose a JSON file exported by this plugin."
msgstr "Виберіть JSON-файл, експортований цим плагіном."

#: src/Admin/ImportExport.php:71
msgid "The file is not valid JSON."
msgstr "Файл не є коректним JSON."

#. translators: 1: dry run prefix, 2: keys, 3: posts, 4: terms, 5: menu items, 6: options, 7: not found
#: src/Admin/ImportExport.php:85
#, php-format
msgid ""
"%1$s%2$d keys: %3$d posts, %4$d terms, %5$d menu items, %6$d options. Not "
"found on this site: %7$d."
msgstr ""
"%1$s%2$d ключів: записів %3$d, термінів %4$d, пунктів меню %5$d, опцій %6$d. "
"Не знайдено на цьому сайті: %7$d."

#: src/Admin/ImportExport.php:86
msgid "[Dry run] "
msgstr "[Пробний запуск] "

#: src/Admin/ImportExport.php:106
msgid "You are not allowed to do this."
msgstr "У вас немає прав на цю дію."

#: src/Admin/SettingsPage.php:58
msgid "Languages"
msgstr "Мови"

#: src/Admin/SettingsPage.php:59
msgid ""
"The default language has no URL prefix (/page/); the others do (/en/page/). "
"The order here is the order of the editor tabs."
msgstr ""
"Мова за замовчуванням без префікса в URL (/page/), решта з префіксом (/en/"
"page/). Порядок тут задає порядок вкладок у редакторі."

